# Copy to terraform.tfvars and edit.

region       = "us-east-2"
cluster_name = "my-eks-cluster"

identity_mode = "pod_identity"

# For IRSA instead of Pod Identity:
# identity_mode     = "irsa"
# oidc_provider_arn = "arn:aws:iam::111122223333:oidc-provider/oidc.eks.us-east-2.amazonaws.com/id/EXAMPLE"
# oidc_provider_url = "https://oidc.eks.us-east-2.amazonaws.com/id/EXAMPLE"

create_ecr_repository = false

tags = {
  Application = "greybeard"
}
